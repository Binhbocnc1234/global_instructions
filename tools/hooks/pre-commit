#!/usr/bin/env python3
"""Preserve the repository-local hook, then check the resulting index."""
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path


def main() -> int:
    scripts = Path(__file__).resolve().parent.parent / "scripts"
    local = Path(subprocess.run(["git", "rev-parse", "--git-common-dir"], capture_output=True, text=True, check=True).stdout.strip()) / "hooks" / "pre-commit"
    if local.exists() and local.resolve() != Path(__file__).resolve():
        if not os.access(local, os.X_OK):
            print(f"Local hook is not executable: {local}", file=sys.stderr)
            return 1
        result = subprocess.run([str(local.resolve())])
        if result.returncode:
            return result.returncode
    for name, arguments in (("check_staged_files.py", []), ("folder_child_limit.py", ["--staged"])):
        result = subprocess.run([sys.executable, str(scripts / name), *arguments])
        if result.returncode:
            return result.returncode
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
